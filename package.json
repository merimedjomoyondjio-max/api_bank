{
  "name": "bank-api",
  "version": "1.0.0",
  "description": "API de gestion bancaire avec SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test JWT_SECRET=birec-test-secret-2026 JWT_EXPIRE=1h jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test JWT_SECRET=birec-test-secret-2026 JWT_EXPIRE=1h jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test JWT_SECRET=birec-test-secret-2026 JWT_EXPIRE=1h jest --coverage --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "verbose": true,
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "bank",
    "api",
    "sqlite",
    "nodejs"
  ],
  "author": "BIREC Cameroon",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "sequelize": "^6.32.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  }
}
